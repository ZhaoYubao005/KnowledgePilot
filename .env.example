# Compose reads .env; plain Python does not. No secrets are required.
# Local Python defaults remain localhost:11434 and CWD/data.
KP_OLLAMA_BASE_URL=http://host.docker.internal:11434
KP_CHAT_MODEL=gemma4:e2b
KP_EMBED_MODEL=bge-m3
KP_API_PORT=8000
# Host-side whole data directory. Use forward slashes on Windows.
# Default ./data belongs to this isolated checkout, not the original main.
KP_HOST_DATA_DIR=./data
# For local Python only, optionally set KP_DATA_DIR to an absolute host path.
# Compose always uses /app/data inside the container.
